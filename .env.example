# OpenRouter / JEV
OPEN_ROUTER_KEY=
JEV_MODEL=typesafe/jev-router
# low | medium | high — empty lets the router decide per request
JEV_REASONING_EFFORT=
JEV_TIMEOUT=60

# Telegram (set in Vercel project env, never commit the value)
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back in a header so only Telegram can call the webhook
TELEGRAM_WEBHOOK_SECRET=
# Customers whose messages get classified (everyone else is stored only)
CLIENT_USERNAMES=belphegorr,semenova_ai,Mitkov96,Marin4cool
# Who gets reports in a private chat (write /start to the bot once)
REPORT_TO=monforje
DEFAULT_CONTRACT=aag_tenders

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
