# OpenRouter / JEV
OPEN_ROUTER_KEY=
JEV_MODEL=typesafe/jev-router
# low | medium | high — empty lets the router decide per request
JEV_REASONING_EFFORT=
JEV_TIMEOUT=60

# Telegram (set in Vercel project env, never commit the value)
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back in a header so only Telegram can call the webhook
TELEGRAM_WEBHOOK_SECRET=
# Internal team chat for reports (empty = store only)
NOTIFY_CHAT_ID=
# Our people: comma-separated Telegram user ids and/or usernames
TEAM_USER_IDS=
TEAM_USERNAMES=monforje
DEFAULT_CONTRACT=aag_tenders

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
